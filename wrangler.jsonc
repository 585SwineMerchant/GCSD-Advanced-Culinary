{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gcsd-advanced-culinary",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-31",
  "assets": {
    "directory": "./site",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/teacher", "/teacher/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "gcsd-advanced-culinary",
      "database_id": "01664687-4437-4a52-9ea2-07b73fe56fa1",
      "migrations_dir": "migrations"
    }
  ],
  "observability": { "enabled": true }
}
