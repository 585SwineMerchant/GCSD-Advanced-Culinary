{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gcsd-advanced-culinary",
  "main": "worker/index.js",
  "compatibility_date": "2026-07-31",
  "assets": { "directory": "./site", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [{ "binding": "DB", "database_name": "gcsd-advanced-culinary", "database_id": "REPLACE_AFTER_D1_CREATION", "migrations_dir": "migrations" }]
}
